# Copy to .env.automation (git-ignored). Read by scripts/*.mjs and scripts/daily-agent.ps1.

# Telegram: scripts/telegram-notify.mjs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bitrix24 tasks mirror: scripts/pm/b24-tasks-sync.mjs (all three required, otherwise the sync is skipped)
# Incoming webhook base with the task scope, trailing slash: https://<portal>.bitrix24.eu/rest/<user>/<token>/
B24_WEBHOOK_URL=
# Workgroup (project) id that holds the mirrored tasks
B24_TASKS_GROUP_ID=
# User id assigned as responsible on created tasks
B24_RESPONSIBLE_ID=
