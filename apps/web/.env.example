# PostgreSQL (docker compose up -d in the repo root gives you this one)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/divan
# Encrypts JWT tokens and other secrets
PAYLOAD_SECRET=change-me
# Public URL of the site, no trailing slash. Used for canonical links, sitemap, OG
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Authenticates cron jobs
CRON_SECRET=change-me
# Validates live preview / draft requests
PREVIEW_SECRET=change-me

# Production only: set to true for the very first deploy without migrations, then remove
# PAYLOAD_DB_PUSH=true

# Brand name shown site-wide until/after naming (CMS Site Settings overrides at runtime)
NEXT_PUBLIC_BRAND_NAME=Divan Shop
